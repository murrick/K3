[Unit]
Description=KANGER
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kanger
Group=kanger
WorkingDirectory=/opt/kanger/current
Environment=KANGER_HOME=KANGER
ExecStartPre=/usr/bin/test -r /opt/kanger/current/server/kanger-server.jar
ExecStart=__JAVA_BIN__ -Duser.home=/var/lib/kanger -jar /opt/kanger/current/server/kanger-server.jar
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillSignal=SIGTERM
UMask=0077

StateDirectory=kanger
StateDirectoryMode=0750

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/var/lib/kanger

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kanger

[Install]
WantedBy=multi-user.target
