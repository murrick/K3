#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  printf 'kanger-admin: run as root (for example: sudo %s)\n' "$0" >&2
  exit 2
fi

command -v java >/dev/null 2>&1 || { echo 'kanger-admin: java not found' >&2; exit 3; }

SERVER_HOME="${KANGER_ADMIN_SERVER_HOME:-/var/lib/kanger}"
SERVER_JAR="${KANGER_ADMIN_SERVER_JAR:-/opt/kanger/current/server/kanger-server.jar}"

[[ -r "${SERVER_JAR}" ]] || {
  printf 'kanger-admin: server JAR not found or unreadable: %s\n' "${SERVER_JAR}" >&2
  exit 3
}

exec java \
  -Duser.home="${SERVER_HOME}" \
  -Dsun.jnu.encoding=UTF-8 \
  -Dfile.encoding=UTF-8 \
  -cp "${SERVER_JAR}" \
  org.kanger.admin.KangerAdmin "$@"
