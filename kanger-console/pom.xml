<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kanger</groupId>
        <artifactId>kanger3-reactor</artifactId>
        <version>3.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kanger3-baseline</artifactId>
    <packaging>jar</packaging>

    <name>KANGER III reproducible baseline</name>
    <description>
        Standalone Java Console adapter over the shared KANGER semantic core.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-command</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-bootstrap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-udf</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-data-dumb</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>${jline.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src</sourceDirectory>

        <resources>
            <resource>
                <directory>${project.basedir}/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/kanger</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-kanger-build-metadata</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <property environment="env"/>
                                <tstamp>
                                    <format property="kanger.build.time" pattern="yyyy-MM-dd_HH:mm:ss"/>
                                </tstamp>

                                <condition property="kanger.build.branch.raw"
                                           value="${kanger.build.branch.override}">
                                    <and>
                                        <isset property="kanger.build.branch.override"/>
                                        <not><equals arg1="${kanger.build.branch.override}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_HEAD_REF}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.GITHUB_HEAD_REF"/>
                                        <not><equals arg1="${env.GITHUB_HEAD_REF}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_REF_NAME}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.GITHUB_REF_NAME"/>
                                        <not><equals arg1="${env.GITHUB_REF_NAME}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.BRANCH_NAME}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.BRANCH_NAME"/>
                                        <not><equals arg1="${env.BRANCH_NAME}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.CI_COMMIT_REF_NAME}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.CI_COMMIT_REF_NAME"/>
                                        <not><equals arg1="${env.CI_COMMIT_REF_NAME}" arg2=""/></not>
                                    </and>
                                </condition>

                                <exec executable="git"
                                      dir="${project.basedir}"
                                      outputproperty="kanger.git.branch"
                                      resultproperty="kanger.git.result"
                                      failifexecutionfails="false"
                                      failonerror="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--abbrev-ref"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <condition property="kanger.build.branch.raw" value="${kanger.git.branch}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="kanger.git.branch"/>
                                        <not><equals arg1="${kanger.git.branch}" arg2=""/></not>
                                    </and>
                                </condition>

                                <fail message="Unable to resolve the KANGER source branch for Maven build metadata">
                                    <condition><not><isset property="kanger.build.branch.raw"/></not></condition>
                                </fail>
                                <loadresource property="kanger.build.branch">
                                    <string value="${kanger.build.branch.raw}"/>
                                    <filterchain><striplinebreaks/></filterchain>
                                </loadresource>
                                <fail message="Resolved an empty KANGER source branch for Maven build metadata">
                                    <condition><equals arg1="${kanger.build.branch}" arg2=""/></condition>
                                </fail>

                                <mkdir dir="${project.build.directory}/generated-resources/kanger/org/kanger"/>
                                <echo file="${project.build.directory}/generated-resources/kanger/org/kanger/build.properties"
                                      message="branch=${kanger.build.branch}&#10;date=${kanger.build.time}&#10;"/>
                                <echo message="KANGER Maven build branch: ${kanger.build.branch}"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-thin-runtime-layout</id>
                        <phase>verify</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <resourcecount property="kanger.console.thin.count">
                                    <fileset dir="${project.build.directory}"
                                             includes="${project.build.finalName}-thin.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.thin.present">
                                    <equals arg1="${kanger.console.thin.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.console.thin.present"
                                      message="Expected exactly one thin Console artifact"/>

                                <available file="${project.build.directory}/runtime/lib"
                                           type="dir"
                                           property="kanger.console.runtime.lib.present"/>
                                <fail unless="kanger.console.runtime.lib.present"
                                      message="Console runtime lib directory was not produced"/>

                                <available file="${project.build.directory}/runtime/modules"
                                           type="dir"
                                           property="kanger.console.runtime.modules.present"/>
                                <fail unless="kanger.console.runtime.modules.present"
                                      message="Console runtime modules directory was not produced"/>

                                <resourcecount property="kanger.console.runtime.udf.count">
                                    <fileset dir="${project.build.directory}/runtime/modules"
                                             includes="kanger-udf-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.runtime.udf.present">
                                    <equals arg1="${kanger.console.runtime.udf.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.console.runtime.udf.present"
                                      message="Expected exactly one UDF Console runtime module"/>

                                <resourcecount property="kanger.console.runtime.storage.count">
                                    <fileset dir="${project.build.directory}/runtime/modules"
                                             includes="kanger-data-dumb-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.runtime.storage.present">
                                    <equals arg1="${kanger.console.runtime.storage.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.console.runtime.storage.present"
                                      message="Expected exactly one DUMB Console runtime module"/>

                                <resourcecount property="kanger.console.runtime.core.count">
                                    <fileset dir="${project.build.directory}/runtime/lib"
                                             includes="kanger-core-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.runtime.core.present">
                                    <equals arg1="${kanger.console.runtime.core.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.console.runtime.core.present"
                                      message="Expected exactly one Core Console runtime library"/>

                                <resourcecount property="kanger.console.runtime.bootstrap.count">
                                    <fileset dir="${project.build.directory}/runtime/lib"
                                             includes="kanger-bootstrap-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.runtime.bootstrap.present">
                                    <equals arg1="${kanger.console.runtime.bootstrap.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.console.runtime.bootstrap.present"
                                      message="Expected exactly one bootstrap Console runtime library"/>

                                <resourcecount property="kanger.console.runtime.provider.leak.count">
                                    <fileset dir="${project.build.directory}/runtime/lib"
                                             includes="kanger-udf-*.jar,kanger-data-dumb-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.console.runtime.providers.isolated">
                                    <equals arg1="${kanger.console.runtime.provider.leak.count}" arg2="0"/>
                                </condition>
                                <fail unless="kanger.console.runtime.providers.isolated"
                                      message="Console runtime provider leaked into runtime/lib"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>thin-runtime</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>thin</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>org.kanger.Kanger</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-libraries</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>kanger-udf,kanger-data-dumb</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/runtime/lib</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-runtime-modules</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>kanger-udf,kanger-data-dumb</includeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/runtime/modules</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.kanger.Kanger</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>