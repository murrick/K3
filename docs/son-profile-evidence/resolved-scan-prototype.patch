+    /** Experimental per-call snapshot. Unsupported inputs retain reference behavior. */
+    private Boolean resolvedScan(ArgumentsList args, Mind mind, java.util.Set<ArgumentsList> rows) {
+        if (rows == null || rows.isEmpty()) return false;
+        if (mind == null || mind.getClass() != Mind.class || args.getClass() != ArgumentsList.class)
+            return null;
+        // Preflight donor tuples before resolving the dynamic left side.
+        for (ArgumentsList row : rows) {
+            if (row == null || row.getClass() != ArgumentsList.class || row.size() != args.size()) return null;
+            for (org.kanger.interfaces.IArgument a : row)
+                if (!(a instanceof org.kanger.primitives.Argument)
+                        || ((org.kanger.primitives.Argument) a).residentScanTerm() == null) return null;
+        }
+        try {
+            for (org.kanger.interfaces.IArgument a : args)
+                if (!(a instanceof org.kanger.primitives.Argument)
+                        || !((org.kanger.primitives.Argument) a).supportsScanResolution()) return null;
+            Term[] values = new Term[args.size()];
+            for (int i = 0; i < values.length; i++) {
+                org.kanger.interfaces.ITerm value = args.get(i).getValue(mind);
+                if (value == null || value.getClass() != Term.class) return null;
+                values[i] = (Term) value;
+            }
+            for (ArgumentsList row : rows) {
+                boolean equal = true;
+                for (int i = 0; i < values.length; i++) {
+                    Term a = values[i];
+                    Term b = ((org.kanger.primitives.Argument) row.get(i)).residentScanTerm();
+                    if (!((a.isCVariable() && b.isCVariable()
+                            && (a.getId() == b.getId() || a.getParentId(mind) == b.getId()
+                            || a.getId() == b.getParentId(mind))) || a.getId() == b.getId())) {
+                        equal = false; break;
+                    }
+                }
+                if (equal) return true;
+            }
+            return false;
+        } catch (Exception unsupported) { return null; }
+    }
