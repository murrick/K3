+    /** Experimental guard: inspect resident built-ins without hydration. */
+    public final boolean supportsScanResolution() throws Exception {
+        if (getClass() != Argument.class || o == null) return false;
+        if (type == ArgumentType.TERM) return o.getClass() == Term.class;
+        if (type == ArgumentType.TVARIABLE && o.getClass() == TVariable.class) {
+            TValue current = ((TVariable) o).getCurrent();
+            return current != null && current.getClass() == TValue.class;
+        }
+        return type == ArgumentType.TVALUE && o.getClass() == TValue.class;
+    }
+
+    public final Term residentScanTerm() {
+        return getClass() == Argument.class && type == ArgumentType.TERM
+            && o != null && o.getClass() == Term.class ? (Term) o : null;
+    }
