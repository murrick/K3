+                || mind.getTerms().getClass() != org.kanger.factory.DictionaryFactory.class || o == null) {
+            return false;
+        }
+        for (org.kanger.interfaces.IMind level = mind; level != null; level = level.getNext()) {
+            if (level.getClass() != Mind.class) return false;
+        }
+        if (type == ArgumentType.TERM) return o.getClass() == Term.class;
+        if (type == ArgumentType.TVALUE) return o.getClass() == TValue.class;
+        if (type != ArgumentType.TVARIABLE || o.getClass() != TVariable.class) return false;
+        TVariable variable = (TVariable) o;
+        Mind active = variable.getMind();
+        if (active == null || active.getClass() != Mind.class
+                || active.getTerms().getClass() != org.kanger.factory.DictionaryFactory.class
+                || active.getTValues().getClass() != org.kanger.factory.TValueFactory.class) return false;
+        TValue current = active.getTValues().get(variable);
+        return current == null || current.getClass() == TValue.class;
+    }
