<project name="K3" default="init" basedir=".">
    <description>
        Generate KANGER build provenance without mutating production sources.
    </description>

    <property name="generated.resources" location="./target/generated-resources/kanger"/>
    <property environment="env"/>

    <tstamp>
        <format property="build.time" pattern="yyyy-MM-dd_HH:mm:ss"/>
    </tstamp>

    <target name="resolve-ci-branch">
        <condition property="build.branch.raw" value="${env.GITHUB_HEAD_REF}">
            <and>
                <isset property="env.GITHUB_HEAD_REF"/>
                <not>
                    <equals arg1="${env.GITHUB_HEAD_REF}" arg2=""/>
                </not>
            </and>
        </condition>

        <condition property="build.branch.raw" value="${env.GITHUB_REF_NAME}">
            <and>
                <not>
                    <isset property="build.branch.raw"/>
                </not>
                <isset property="env.GITHUB_REF_NAME"/>
                <not>
                    <equals arg1="${env.GITHUB_REF_NAME}" arg2=""/>
                </not>
            </and>
        </condition>

        <condition property="build.branch.raw" value="${env.BRANCH_NAME}">
            <and>
                <not>
                    <isset property="build.branch.raw"/>
                </not>
                <isset property="env.BRANCH_NAME"/>
                <not>
                    <equals arg1="${env.BRANCH_NAME}" arg2=""/>
                </not>
            </and>
        </condition>

        <condition property="build.branch.raw" value="${env.CI_COMMIT_REF_NAME}">
            <and>
                <not>
                    <isset property="build.branch.raw"/>
                </not>
                <isset property="env.CI_COMMIT_REF_NAME"/>
                <not>
                    <equals arg1="${env.CI_COMMIT_REF_NAME}" arg2=""/>
                </not>
            </and>
        </condition>
    </target>

    <target name="resolve-git-branch" depends="resolve-ci-branch" unless="build.branch.raw">
        <exec executable="git"
              outputproperty="build.branch.raw"
              failifexecutionfails="true"
              failonerror="true">
            <arg value="rev-parse"/>
            <arg value="--abbrev-ref"/>
            <arg value="HEAD"/>
        </exec>
    </target>

    <target name="init" depends="resolve-git-branch">
        <loadresource property="build.branch">
            <string value="${build.branch.raw}"/>
            <filterchain>
                <striplinebreaks/>
            </filterchain>
        </loadresource>

        <fail message="Unable to resolve the KANGER source branch for build metadata">
            <condition>
                <or>
                    <not>
                        <isset property="build.branch"/>
                    </not>
                    <equals arg1="${build.branch}" arg2=""/>
                </or>
            </condition>
        </fail>

        <echo message="KANGER build source branch: ${build.branch}"/>
        <mkdir dir="${generated.resources}/org/kanger"/>
        <echo file="${generated.resources}/org/kanger/build.properties"
              message="branch=${build.branch}&#10;source.branch=${build.branch}&#10;date=${build.time}&#10;"/>
    </target>
</project>