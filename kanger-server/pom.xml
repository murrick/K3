<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kanger</groupId>
        <artifactId>kanger3-reactor</artifactId>
        <version>3.3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>kanger-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>KANGER Server</name>
    <description>
        Reproducible standalone KANGER network delivery shell over the shared
        KANGER semantic core.
    </description>

    <properties>
        <org.json.version>20201115</org.json.version>
        <javax.mail.version>1.6.2</javax.mail.version>
        <junit.jupiter.version>5.10.3</junit.jupiter.version>
        <kanger.server.artifact.version>server-0.18</kanger.server.artifact.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-command</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-bootstrap</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-udf</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.kanger</groupId>
            <artifactId>kanger-data-dumb</artifactId>
            <version>${project.parent.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${org.json.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>${javax.mail.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <testSourceDirectory>${project.basedir}/test</testSourceDirectory>
        <finalName>kanger-server</finalName>

        <resources>
            <resource>
                <directory>${project.build.directory}/generated-resources/kanger</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-kanger-build-metadata</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property environment="env"/>
                                <tstamp>
                                    <format property="kanger.build.time" pattern="yyyy-MM-dd_HH:mm:ss"/>
                                </tstamp>

                                <condition property="kanger.build.branch.raw"
                                           value="${kanger.build.branch.override}">
                                    <and>
                                        <isset property="kanger.build.branch.override"/>
                                        <not><equals arg1="${kanger.build.branch.override}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_HEAD_REF}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.GITHUB_HEAD_REF"/>
                                        <not><equals arg1="${env.GITHUB_HEAD_REF}" arg2=""/></not>
                                    </and>
                                </condition>
                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_REF_NAME}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="env.GITHUB_REF_NAME"/>
                                        <not><equals arg1="${env.GITHUB_REF_NAME}" arg2=""/></not>
                                    </and>
                                </condition>

                                <exec executable="git"
                                      dir="${project.basedir}"
                                      outputproperty="kanger.git.branch"
                                      resultproperty="kanger.git.result"
                                      failifexecutionfails="false"
                                      failonerror="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--abbrev-ref"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <condition property="kanger.build.branch.raw" value="${kanger.git.branch}">
                                    <and>
                                        <not><isset property="kanger.build.branch.raw"/></not>
                                        <isset property="kanger.git.branch"/>
                                        <not><equals arg1="${kanger.git.branch}" arg2=""/></not>
                                    </and>
                                </condition>

                                <fail message="Unable to resolve the KANGER Server source branch">
                                    <condition><not><isset property="kanger.build.branch.raw"/></not></condition>
                                </fail>
                                <loadresource property="kanger.build.branch">
                                    <string value="${kanger.build.branch.raw}"/>
                                    <filterchain><striplinebreaks/></filterchain>
                                </loadresource>

                                <fail message="KANGER Server artifact version must not be empty">
                                    <condition>
                                        <or>
                                            <not><isset property="kanger.server.artifact.version"/></not>
                                            <equals arg1="${kanger.server.artifact.version}" arg2=""/>
                                        </or>
                                    </condition>
                                </fail>

                                <mkdir dir="${project.build.directory}/generated-resources/kanger/org/kanger"/>
                                <echo file="${project.build.directory}/generated-resources/kanger/org/kanger/build.properties"
                                      message="branch=${kanger.server.artifact.version}&#10;source.branch=${kanger.build.branch}&#10;server.version=${kanger.server.artifact.version}&#10;date=${kanger.build.time}&#10;"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-thin-runtime-layout</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <available file="${project.build.directory}/kanger-server-thin.jar"
                                           property="kanger.thin.jar.present"/>
                                <fail unless="kanger.thin.jar.present"
                                      message="Thin Server artifact was not produced"/>

                                <available file="${project.build.directory}/runtime/lib"
                                           type="dir"
                                           property="kanger.runtime.lib.present"/>
                                <fail unless="kanger.runtime.lib.present"
                                      message="Server runtime lib directory was not produced"/>

                                <available file="${project.build.directory}/runtime/modules"
                                           type="dir"
                                           property="kanger.runtime.modules.present"/>
                                <fail unless="kanger.runtime.modules.present"
                                      message="Server runtime modules directory was not produced"/>

                                <resourcecount property="kanger.runtime.udf.count">
                                    <fileset dir="${project.build.directory}/runtime/modules"
                                             includes="kanger-udf-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.runtime.udf.present">
                                    <equals arg1="${kanger.runtime.udf.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.runtime.udf.present"
                                      message="Expected exactly one UDF runtime module"/>

                                <resourcecount property="kanger.runtime.storage.count">
                                    <fileset dir="${project.build.directory}/runtime/modules"
                                             includes="kanger-data-dumb-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.runtime.storage.present">
                                    <equals arg1="${kanger.runtime.storage.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.runtime.storage.present"
                                      message="Expected exactly one DUMB storage runtime module"/>

                                <resourcecount property="kanger.runtime.core.count">
                                    <fileset dir="${project.build.directory}/runtime/lib"
                                             includes="kanger-core-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.runtime.core.present">
                                    <equals arg1="${kanger.runtime.core.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.runtime.core.present"
                                      message="Expected exactly one Core runtime library"/>

                                <resourcecount property="kanger.runtime.bootstrap.count">
                                    <fileset dir="${project.build.directory}/runtime/lib"
                                             includes="kanger-bootstrap-*.jar"/>
                                </resourcecount>
                                <condition property="kanger.runtime.bootstrap.present">
                                    <equals arg1="${kanger.runtime.bootstrap.count}" arg2="1"/>
                                </condition>
                                <fail unless="kanger.runtime.bootstrap.present"
                                      message="Expected exactly one bootstrap runtime library"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>thin-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>thin</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-libraries</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>kanger-udf,kanger-data-dumb</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/runtime/lib</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-runtime-modules</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>kanger-udf,kanger-data-dumb</includeArtifactIds>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/runtime/modules</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.kanger.Kanger</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
