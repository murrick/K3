# KANGER Server production configuration
# Installed as /etc/kanger-server/kanger.conf and linked into the service state home.

server.bind.address=127.0.0.1
server.port=1964
server.backlog=128
server.maxthreads=32
server.queue.capacity=128
server.request.max.body.bytes=1048576
server.watchdog.period=1000

# Browser clients require exact origins. The public UI is served separately from
# the API, so allow the exact UI origins that will call https://api.kanger.org.
# server.cors.allowed.origin.1=https://kanger.org
# server.cors.allowed.origin.2=https://www.kanger.org
# server.cors.allow.credentials=false

# Public API URL used in generated confirmation links.
# server.url=https://api.kanger.org

# Confirmation mail is disabled until a complete explicit profile is supplied.
# Choose exactly one mode: disabled, starttls, or smtps.
server.email.mode=disabled
server.email.debug=false
server.email.auth=true
server.email.connection.timeout.millis=10000
server.email.read.timeout.millis=10000
server.email.write.timeout.millis=10000
server.email.workers=1
server.email.queue.capacity=64

# STARTTLS example (typically port 587):
# server.email.mode=starttls
# server.email.host=smtp.example.org
# server.email.port=587
# server.email.from=noreply@example.org
# server.email.login=noreply@example.org
# server.email.password=CHANGE_ME

# Implicit TLS / SMTPS example (typically port 465):
# server.email.mode=smtps
# server.email.host=smtp.example.org
# server.email.port=465
# server.email.from=noreply@example.org
# server.email.login=noreply@example.org
# server.email.password=CHANGE_ME
