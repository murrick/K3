# Replace KANGER_DOMAIN and certificate paths before enabling this file.
# KANGER Server itself must remain bound to 127.0.0.1:1964.

upstream kanger_server_backend {
    server 127.0.0.1:1964;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name KANGER_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name KANGER_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/KANGER_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/KANGER_DOMAIN/privkey.pem;

    client_max_body_size 1m;

    location = /health {
        proxy_pass http://kanger_server_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        access_log off;
    }

    # Detailed readiness includes bounded-worker counters and remains local to
    # the VPS. External monitoring should use /health.
    location = /ready {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://kanger_server_backend/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        access_log off;
    }

    location / {
        proxy_pass http://kanger_server_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 120s;
    }
}
