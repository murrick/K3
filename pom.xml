<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.kanger</groupId>
    <artifactId>kanger3-baseline</artifactId>
    <version>3.3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>KANGER III reproducible baseline</name>
    <description>
        Aggregate build of the four source roots used by the current Eclipse baseline.
        This is a stabilization harness, not a redesign of the historical module packaging.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}/kanger/src</sourceDirectory>

        <resources>
            <resource>
                <directory>${project.basedir}/kanger/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/kanger-console/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/kanger-udf/src</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/kanger</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-kanger-build-metadata</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property environment="env"/>

                                <tstamp>
                                    <format property="kanger.build.time" pattern="yyyy-MM-dd_HH:mm:ss"/>
                                </tstamp>

                                <condition property="kanger.build.branch.raw"
                                           value="${kanger.build.branch.override}">
                                    <and>
                                        <isset property="kanger.build.branch.override"/>
                                        <not>
                                            <equals arg1="${kanger.build.branch.override}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_HEAD_REF}">
                                    <and>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                        <isset property="env.GITHUB_HEAD_REF"/>
                                        <not>
                                            <equals arg1="${env.GITHUB_HEAD_REF}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <condition property="kanger.build.branch.raw" value="${env.GITHUB_REF_NAME}">
                                    <and>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                        <isset property="env.GITHUB_REF_NAME"/>
                                        <not>
                                            <equals arg1="${env.GITHUB_REF_NAME}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <condition property="kanger.build.branch.raw" value="${env.BRANCH_NAME}">
                                    <and>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                        <isset property="env.BRANCH_NAME"/>
                                        <not>
                                            <equals arg1="${env.BRANCH_NAME}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <condition property="kanger.build.branch.raw" value="${env.CI_COMMIT_REF_NAME}">
                                    <and>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                        <isset property="env.CI_COMMIT_REF_NAME"/>
                                        <not>
                                            <equals arg1="${env.CI_COMMIT_REF_NAME}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <exec executable="git"
                                      outputproperty="kanger.git.branch"
                                      resultproperty="kanger.git.result"
                                      failifexecutionfails="false"
                                      failonerror="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--abbrev-ref"/>
                                    <arg value="HEAD"/>
                                </exec>

                                <condition property="kanger.build.branch.raw" value="${kanger.git.branch}">
                                    <and>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                        <isset property="kanger.git.branch"/>
                                        <not>
                                            <equals arg1="${kanger.git.branch}" arg2=""/>
                                        </not>
                                    </and>
                                </condition>

                                <fail message="Unable to resolve the KANGER source branch for Maven build metadata">
                                    <condition>
                                        <not>
                                            <isset property="kanger.build.branch.raw"/>
                                        </not>
                                    </condition>
                                </fail>

                                <loadresource property="kanger.build.branch">
                                    <string value="${kanger.build.branch.raw}"/>
                                    <filterchain>
                                        <striplinebreaks/>
                                    </filterchain>
                                </loadresource>

                                <fail message="Resolved an empty KANGER source branch for Maven build metadata">
                                    <condition>
                                        <equals arg1="${kanger.build.branch}" arg2=""/>
                                    </condition>
                                </fail>

                                <mkdir dir="${project.build.directory}/generated-resources/kanger/org/kanger"/>
                                <echo file="${project.build.directory}/generated-resources/kanger/org/kanger/build.properties"
                                      message="branch=${kanger.build.branch}&#10;date=${kanger.build.time}&#10;"/>
                                <echo message="KANGER Maven build branch: ${kanger.build.branch}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-kanger-source-roots</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/kanger-udf/src</source>
                                <source>${project.basedir}/kanger-data-dumb/src</source>
                                <source>${project.basedir}/kanger-console/src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>kanger-regression-corpus</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-Dkanger.test.home=${project.build.directory}/kanger-test-home</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>org.kanger.KangerTestRunner</argument>
                                <argument>set_</argument>
                            </arguments>
                            <classpathScope>runtime</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.kanger.Kanger</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
