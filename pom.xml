<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.kanger</groupId>
    <artifactId>kanger3-reactor</artifactId>
    <version>3.3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>KANGER III Maven reactor</name>
    <description>
        Reactor boundary for the canonical command language, shared KANGER
        semantic core, runtime composition, optional runtime plugins, and
        Console and Server adapters. Production Java sources remain in their
        historical directories; Maven expresses the compilation dependencies
        explicitly.
    </description>

    <modules>
        <module>kanger-command</module>
        <module>kanger-core</module>
        <module>kanger-bootstrap</module>
        <module>kanger-udf</module>
        <module>kanger-data-dumb</module>
        <module>kanger-console</module>
        <module>kanger-server</module>
        <module>kanger-qualification</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <jline.version>3.13.0</jline.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>reset-reactor-test-home</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/test-home"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cleanup-reactor-test-home</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/test-home"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-reactor-test-home-cleaned</id>
                        <phase>verify</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <available file="${project.build.directory}/test-home"
                                           type="dir"
                                           property="kanger.test.home.remaining"/>
                                <fail if="kanger.test.home.remaining"
                                      message="Test home survived Maven verification for ${project.artifactId}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <kanger.test.home>${project.build.directory}/test-home</kanger.test.home>
                        <user.home>${project.build.directory}/test-home</user.home>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <KANGER_HOME>KANGER</KANGER_HOME>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
